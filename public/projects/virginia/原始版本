// ─── LETTER OVERLAY ───
function openLetter(id) {
    const l=dbLetters.find(x=> x.id===id);
    if ( !l) return;
    const overlay=document.getElementById('letter-overlay');
    const bgLayer=document.getElementById('letter-bg-layer');
    const displayText=document.getElementById('displayText');
    const fromDisplay=document.getElementById('letter-from-display');
    const dateDisplay=document.getElementById('letter-date-display');

    bgLayer.style.backgroundImage=`url('${l.image}')`;

    fromDisplay.textContent=`From: $ {
        l.sender==='vita' ? 'Vita Sackville-West': 'Virginia Woolf'
    }

    `;
    dateDisplay.textContent=l.date;
    displayText.innerHTML='<span class="cursor"></span>';

    overlay.classList.add('active');
    clearTimeout(typingTimer);
    setTimeout(()=> typeText(l.text, displayText), 700);
}

function typeText(fullText, container) {
    let i=0;

    function step() {
        const cursor=container.querySelector('.cursor');

        if (i < fullText.length) {
            const char=fullText[i++];
            const span=document.createElement('span');
            span.textContent=char;

            if (cursor && cursor.parentNode===container) {
                container.insertBefore(span, cursor);
            }

            else {
                container.appendChild(span);
            }

            let delay=30+Math.random() * 45;
            if (char===' ') delay+=30;
            if (/[., !?]/.test(char)) delay+=350;
            if (char==='\n') delay+=700;
            typingTimer=setTimeout(step, delay);
        }

        else if (cursor) {
            cursor.style.display='none';
        }
    }

    step();
}

document.getElementById('letter-overlay').addEventListener('click', ()=> {
        document.getElementById('letter-overlay').classList.remove('active');
        clearTimeout(typingTimer);
    });

