< !DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Love Letters — Virginia Woolf & Vita Sackville-West</title><link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=EB+Garamond:ital,wght@0,400;0,700;1,400;1,700&family=Great+Vibes&family=Playfair+Display:wght@400;600;700;800&display=swap" rel="stylesheet"><script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script><style> :root {
    --paper-color: #e6dfcf;
    --ink-color: #2b2b2b;
    --bg-dark: #060606;
    --accent-gold: #c5a059;
    --accent-gold-soft: rgba(197, 160, 89, 0.15);
    --accent-gold-glow: rgba(197, 160, 89, 0.08);
    --transition-silky: all 1.2s cubic-bezier(0.7, 0, 0.3, 1);
    --paper-width: 640px;
    --paper-height: 82vh;
    --paper-font-size: 0.92rem;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

::-webkit-scrollbar {
    width: 3px;
}

::-webkit-scrollbar-track {
    background: transparent;
}

::-webkit-scrollbar-thumb {
    background: rgba(197, 160, 89, 0.3);
    border-radius: 2px;
}

body {
    background-color: var(--bg-dark);
    color: #eee;
    font-family: 'EB Garamond', serif;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
}

/* 全局噪点 */
body::after {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 250 250' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    opacity: 0.06;
    pointer-events: none;
    z-index: 9999;
}

/* ─── LANDING ─── */
#landing-page {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 200;
    text-align: center;
    padding: 20px;
    background-color: var(--bg-dark);
    transition: transform 1.4s cubic-bezier(0.76, 0, 0.24, 1), opacity 1.4s ease;
}

#landing-page.hidden {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
}

#landing-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.88)),
        url('https://pastlovespodcast.co.uk/wp-content/uploads/2022/05/56.jpg?w=1568');
    background-size: cover;
    background-position: center;
    z-index: -1;
}

.vignette-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 40%, rgba(0, 0, 0, 0.85) 100%);
    pointer-events: none;
}

.reveal-text {
    opacity: 0;
    transform: translateY(30px);
    animation: fadeInUp 2.5s forwards cubic-bezier(0.23, 1, 0.32, 1);
}

@keyframes fadeInUp {
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.landing-prefix {
    font-family: 'Playfair Display', serif;
    font-size: clamp(0.9rem, 2vw, 1.2rem);
    font-weight: 700;
    letter-spacing: 20px;
    text-transform: uppercase;
    color: var(--accent-gold);
    margin-bottom: 22px;
    animation-delay: 0.2s;
    text-indent: 20px;
    opacity: 0;
}

.landing-title {
    font-family: 'Great Vibes', cursive;
    font-size: clamp(3rem, 9vw, 6.5rem);
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 18px;
    line-height: 1.1;
    filter: blur(0.8px) contrast(1.1);
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.1), 0 0 45px rgba(197, 160, 89, 0.2), 3px 3px 15px rgba(0, 0, 0, 0.9);
    user-select: none;
    max-width: 85%;
}

.title-word {
    display: inline-block;
    opacity: 0;
    transform: translateY(40px) scale(0.95);
    animation: elegantEnter 2.4s forwards cubic-bezier(0.19, 1, 0.22, 1);
}

@keyframes elegantEnter {
    0% {
        opacity: 0;
        transform: translateY(40px) scale(0.95);
        filter: blur(8px);
    }

    100% {
        opacity: 1;
        transform: translateY(0) scale(1);
        filter: blur(0);
    }
}

.title-word:nth-child(1) {
    animation-delay: 0.6s;
}

.title-word:nth-child(2) {
    animation-delay: 0.9s;
}

.title-word:nth-child(3) {
    animation-delay: 1.2s;
    font-size: 0.7em;
    margin: 0 10px;
    opacity: 0.7;
}

.title-word:nth-child(4) {
    animation-delay: 1.5s;
}

.title-word:nth-child(5) {
    animation-delay: 1.8s;
}

.landing-subtitle {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: clamp(0.85rem, 1.8vw, 1.1rem);
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: 3px;
    margin-bottom: 55px;
    opacity: 0;
    animation: fadeInUp 2s forwards;
    animation-delay: 2.2s;
}

.enter-btn-wrap {
    position: relative;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    animation: fadeInUp 2s forwards;
    animation-delay: 2.8s;
    transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    color: var(--accent-gold);
}

.enter-btn-wrap svg {
    width: 38px;
    height: 38px;
    fill: none;
    stroke: currentColor;
    stroke-width: 0.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.4s ease;
}

.enter-btn-wrap:hover svg {
    transform: translateY(6px);
    color: #fff;
}

/* ─── MAIN CONTENT ─── */
#main-content {
    min-height: 100vh;
    opacity: 0;
    transition: opacity 1s ease 0.3s;
}

#main-content.visible {
    opacity: 1;
}

/* ─── NAVIGATION ─── */
#top-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 22px 50px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(to bottom, rgba(6, 6, 6, 0.95), transparent);
    backdrop-filter: blur(0px);
    transition: all 0.5s ease;
}

#top-nav.scrolled {
    backdrop-filter: blur(20px);
    background: rgba(6, 6, 6, 0.85);
    border-bottom: 1px solid rgba(197, 160, 89, 0.08);
}

.nav-brand {
    font-family: 'Great Vibes', cursive;
    font-size: 1.6rem;
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    text-shadow: 0 0 20px rgba(197, 160, 89, 0.3);
}

.nav-links {
    display: flex;
    gap: 35px;
    list-style: none;
}

.nav-links a {
    font-family: 'Playfair Display', serif;
    font-size: 0.65rem;
    letter-spacing: 8px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    text-decoration: none;
    transition: color 0.3s;
}

.nav-links a:hover {
    color: var(--accent-gold);
}

/* ─── HERO SECTION ─── */
#hero-section {
    height: 100vh;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

#hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(6, 6, 6, 1)),
        url('https://pastlovespodcast.co.uk/wp-content/uploads/2022/05/56.jpg?w=1568');
    background-size: cover;
    background-position: center;
    transform: scale(1.05);
    transition: transform 0.1s linear;
}

.hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 20px;
}

.hero-eyebrow {
    font-family: 'Playfair Display', serif;
    font-size: 0.7rem;
    letter-spacing: 18px;
    text-transform: uppercase;
    color: var(--accent-gold);
    margin-bottom: 20px;
    text-indent: 18px;
}

.hero-title {
    font-family: 'Great Vibes', cursive;
    font-size: clamp(3.5rem, 8vw, 7rem);
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.1;
    text-shadow: 0 0 60px rgba(197, 160, 89, 0.25), 3px 3px 20px rgba(0, 0, 0, 0.9);
    margin-bottom: 20px;
}

.hero-subtitle {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: clamp(1rem, 2vw, 1.3rem);
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 2px;
    margin-bottom: 60px;
}

.scroll-indicator {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: rgba(197, 160, 89, 0.5);
    font-family: 'Playfair Display', serif;
    font-size: 0.55rem;
    letter-spacing: 6px;
    text-transform: uppercase;
    animation: bounce 2s infinite;
}

@keyframes bounce {

    0%,
    100% {
        transform: translateX(-50%) translateY(0);
    }

    50% {
        transform: translateX(-50%) translateY(8px);
    }
}

.scroll-indicator svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
}

/* ─── SECTION COMMON ─── */
.section {
    padding: 100px 0;
    position: relative;
}

.section-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 50px;
}

.section-header {
    text-align: center;
    margin-bottom: 70px;
}

.section-label {
    font-family: 'Playfair Display', serif;
    font-size: 0.6rem;
    letter-spacing: 14px;
    text-transform: uppercase;
    color: var(--accent-gold);
    margin-bottom: 16px;
    text-indent: 14px;
}

.section-title {
    font-family: 'Great Vibes', cursive;
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: rgba(255, 255, 255, 0.88);
    text-shadow: 0 0 30px rgba(197, 160, 89, 0.15);
}

.section-divider {
    width: 60px;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--accent-gold), transparent);
    margin: 20px auto 0;
}

/* ─── TIMELINE SECTION ─── */
#timeline-section {
    background: linear-gradient(to bottom, var(--bg-dark), #0a0a0a, var(--bg-dark));
}

.timeline {
    position: relative;
    padding: 20px 0;
}

.timeline::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgba(197, 160, 89, 0.3), transparent);
    transform: translateX(-50%);
}

.timeline-item {
    display: flex;
    justify-content: flex-end;
    padding-right: calc(50% + 50px);
    margin-bottom: 60px;
    position: relative;
    opacity: 0;
    transform: translateX(-30px);
    transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
}

.timeline-item.right {
    justify-content: flex-start;
    padding-right: 0;
    padding-left: calc(50% + 50px);
    transform: translateX(30px);
}

.timeline-item.visible {
    opacity: 1;
    transform: translateX(0);
}

.timeline-dot {
    position: absolute;
    left: 50%;
    top: 25px;
    width: 12px;
    height: 12px;
    background: var(--accent-gold);
    border-radius: 50%;
    transform: translateX(-50%);
    box-shadow: 0 0 20px rgba(197, 160, 89, 0.5);
}

.timeline-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(197, 160, 89, 0.1);
    padding: 28px 32px;
    max-width: 420px;
    width: 100%;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
    position: relative;
    overflow: hidden;
}

.timeline-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(197, 160, 89, 0.05), transparent);
    opacity: 0;
    transition: opacity 0.4s;
}

.timeline-card:hover {
    border-color: rgba(197, 160, 89, 0.35);
    transform: translateY(-4px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6), 0 0 30px rgba(197, 160, 89, 0.08);
}

.timeline-card:hover::before {
    opacity: 1;
}

.timeline-sender {
    font-family: 'Playfair Display', serif;
    font-size: 0.55rem;
    letter-spacing: 8px;
    text-transform: uppercase;
    color: var(--accent-gold);
    margin-bottom: 8px;
}

.timeline-date {
    font-family: 'Special Elite', monospace;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 14px;
}

.timeline-quote {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.7;
    border-left: 2px solid rgba(197, 160, 89, 0.3);
    padding-left: 16px;
}

.timeline-thumb {
    width: 100%;
    height: 120px;
    object-fit: cover;
    margin-top: 18px;
    filter: grayscale(0.4) brightness(0.7);
    transition: filter 0.4s;
}

.timeline-card:hover .timeline-thumb {
    filter: grayscale(0.1) brightness(0.85);
}

.read-more-hint {
    margin-top: 14px;
    font-family: 'Playfair Display', serif;
    font-size: 0.5rem;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: rgba(197, 160, 89, 0.5);
    display: flex;
    align-items: center;
    gap: 8px;
}

.read-more-hint svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    transition: transform 0.3s;
}

.timeline-card:hover .read-more-hint svg {
    transform: translateX(4px);
}

/* ─── STATS SECTION ─── */
#stats-section {
    background: #080808;
    border-top: 1px solid rgba(197, 160, 89, 0.06);
    border-bottom: 1px solid rgba(197, 160, 89, 0.06);
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(197, 160, 89, 0.06);
}

.stat-card {
    background: #080808;
    padding: 50px 30px;
    text-align: center;
    transition: background 0.4s;
}

.stat-card:hover {
    background: rgba(197, 160, 89, 0.04);
}

.stat-number {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 4vw, 3.8rem);
    font-weight: 700;
    color: var(--accent-gold);
    line-height: 1;
    margin-bottom: 12px;
}

.stat-label {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 1px;
}

/* ─── CHART SECTION ─── */
#chart-section {
    background: var(--bg-dark);
}

.charts-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
}

.chart-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(197, 160, 89, 0.1);
    padding: 35px;
    transition: border-color 0.4s;
}

.chart-card:hover {
    border-color: rgba(197, 160, 89, 0.2);
}

.chart-card-title {
    font-family: 'Playfair Display', serif;
    font-size: 0.6rem;
    letter-spacing: 10px;
    text-transform: uppercase;
    color: var(--accent-gold);
    margin-bottom: 8px;
    text-indent: 10px;
}

.chart-card-desc {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.35);
    margin-bottom: 25px;
}

.chart-wrapper {
    position: relative;
    height: 260px;
}

.chart-full {
    grid-column: 1 / -1;
}

.chart-full .chart-wrapper {
    height: 300px;
}

/* ─── GALLERY SECTION ─── */
#gallery-section {
    background: #080808;
}

.gallery-filter-bar {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 50px;
    flex-wrap: wrap;
}

.filter-btn {
    font-family: 'Playfair Display', serif;
    font-size: 0.55rem;
    letter-spacing: 7px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 10px 22px;
    cursor: pointer;
    transition: all 0.3s;
    text-indent: 7px;
}

.filter-btn:hover,
.filter-btn.active {
    color: var(--accent-gold);
    border-color: rgba(197, 160, 89, 0.4);
    background: rgba(197, 160, 89, 0.05);
}

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
}

.gallery-card {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(197, 160, 89, 0.08);
    transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    opacity: 0;
    transform: translateY(20px);
}

.gallery-card.visible {
    opacity: 1;
    transform: translateY(0);
}

.gallery-card:hover {
    border-color: rgba(197, 160, 89, 0.3);
    transform: translateY(-6px);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.7);
}

.gallery-card img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
    filter: grayscale(0.5) brightness(0.65);
    transition: filter 0.5s, transform 0.5s;
}

.gallery-card:hover img {
    filter: grayscale(0.1) brightness(0.8);
    transform: scale(1.04);
}

.gallery-card-info {
    padding: 20px 22px;
}

.gallery-card-sender {
    font-family: 'Playfair Display', serif;
    font-size: 0.5rem;
    letter-spacing: 7px;
    text-transform: uppercase;
    color: var(--accent-gold);
    margin-bottom: 6px;
}

.gallery-card-date {
    font-family: 'Special Elite', monospace;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 10px;
}

.gallery-card-quote {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* ─── LETTER OVERLAY ─── */
#letter-overlay {
    position: fixed;
    inset: 0;
    z-index: 500;
    background: rgba(0, 0, 0, 0.96);
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.8s cubic-bezier(0.2, 1, 0.3, 1);
    cursor: pointer;
}

#letter-overlay.active {
    opacity: 1;
    visibility: visible;
}

#letter-bg-layer {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: blur(80px) brightness(0.12);
    z-index: -1;
}

.letter-paper {
    background-color: var(--paper-color);
    width: 90%;
    max-width: var(--paper-width);
    height: var(--paper-height);
    padding: clamp(50px, 10vh, 100px) clamp(30px, 8vw, 75px);
    position: relative;
    color: var(--ink-color);
    box-shadow: 0 60px 180px rgba(0, 0, 0, 0.98);
    background-image: radial-gradient(circle at center, transparent 30%, rgba(139, 117, 72, 0.05) 100%),
        url("https://www.transparenttextures.com/patterns/old-map.png");
    transform: scale(0.88) translateY(50px) rotate(-0.4deg);
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    overflow-y: auto;
    cursor: default;
    display: flex;
    flex-direction: column;
}

#letter-overlay.active .letter-paper {
    transform: scale(1) translateY(0) rotate(0.15deg);
}

.letter-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(43, 43, 43, 0.15);
}

.letter-from {
    font-family: 'Special Elite', monospace;
    font-size: 0.75rem;
    color: #5a4b3d;
    letter-spacing: 2px;
}

.letter-date-display {
    font-family: 'Special Elite', monospace;
    font-size: 0.75rem;
    color: #8a7a6a;
    text-align: right;
}

.letter-content {
    font-family: 'Special Elite', monospace;
    font-size: var(--paper-font-size);
    line-height: 1.9;
    white-space: pre-wrap;
    color: #2b2b2b;
    filter: blur(0.15px);
    opacity: 0.9;
    flex: 1;
}

.cursor {
    display: inline-block;
    width: 2px;
    height: 1.15em;
    background-color: rgba(43, 43, 43, 0.5);
    vertical-align: middle;
    margin-left: 2px;
    animation: blink 1s infinite;
}

@keyframes blink {

    0%,
    100% {
        opacity: 1;
    }

    50% {
        opacity: 0;
    }
}

.letter-close-hint {
    position: absolute;
    top: 20px;
    right: 20px;
    font-family: 'Playfair Display', serif;
    font-size: 0.45rem;
    letter-spacing: 4px;
    text-transform: uppercase;
